# ══════════════════════════════════════════
# Google Service Account Credentials
# ══════════════════════════════════════════
# Get these from Google Cloud Console → Service Account → Keys → JSON
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ══════════════════════════════════════════
# Google Drive Folder IDs
# ══════════════════════════════════════════
# Open each folder in Google Drive → the ID is in the URL:
# https://drive.google.com/drive/folders/FOLDER_ID_HERE
#
# Parent folder containing 3 subfolders:
#   ├── ColorProof/      (CSVs for ColorProof store)
#   ├── NeumaBeauty/     (CSVs for NeumaBeauty store)
#   └── Number4Hair/     (CSVs for Number 4 Hair store)

DRIVE_FOLDER_COLORPROOF=your_colorproof_folder_id
DRIVE_FOLDER_NEUMABEAUTY=your_neumabeauty_folder_id
DRIVE_FOLDER_NUMBER4=your_number4_folder_id

# ══════════════════════════════════════════
# Optional: Caching (seconds) — default 1 hour
# ══════════════════════════════════════════
CACHE_TTL=3600
